# No datasets in git: raw, gated, derived, or compiled.
/data/
/full-wiki-logs/
*.zip
*.gz
*.jsonl
*.csv
*.parquet
*.pkl
*.npy
*.db
*.sqlite

# Analysis outputs are data too; keep only reports and figures.
village_tools/out/*
!village_tools/out/scaling/
!village_tools/out/coherence/
village_tools/out/scaling/*
village_tools/out/coherence/*
!village_tools/out/*/*.png
!village_tools/out/*/REPORT.md

# Python
__pycache__/
*.pyc
.venv/
.cache/

# SwarmScope stores (with DuckDB's write-ahead log) hold dataset text
*.duckdb
*.duckdb.wal

# SwarmScope rubric sweeps (verdicts over dataset records are derived data), at any depth
**/sweeps/

# Dataset setup outputs: profiles hold masked dataset excerpts, setup logs and task files
# hold absolute paths and field names. The mapping (<source>.json) itself may be committed.
**/mappings/*.profile.json
**/mappings/*.setup.json
**/mappings/*.task.md

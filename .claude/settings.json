{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__swarm__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/audit_log.py\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/require_evidence.py\" || exit 1",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
